version: v1.25.0
ignore:
  SNYK-JS-HTTPCACHESEMANTICS-19964064:
    - '*':
        reason: >
          http-cache-semantics resolved as npm's own internal HTTP client
          dependency (npm@11.19.1 > make-fetch-happen@15.0.6 >
          http-cache-semantics), used only by npm itself during package
          install/registry requests — surfaced solely in the "lib" project
          scan (/usr/local/lib/node_modules, npm's own global install),
          not the application's own dependency tree (app scan clean, 308
          dependencies tested, no vulnerable paths). This app's own HTTP
          dependencies are AWS SDK v3 clients (@aws-sdk/client-s3,
          @aws-sdk/client-sqs), which use their own internal HTTP handling,
          not make-fetch-happen, so this app never exercises the vulnerable
          caching path at all. Build/CLI tooling only, not independently
          controllable without patching npm's tree. Recheck when npm bumps
          its bundled make-fetch-happen.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-HTTPCACHESEMANTICS-19964068:
    - '*':
        reason: >
          Same root cause as SNYK-JS-HTTPCACHESEMANTICS-19964064 — npm's
          own bundled make-fetch-happen, build/CLI tooling only, never
          exercised by this application's own code.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-BRACEEXPANSION-20244948:
    - '*':
        reason: >
          brace-expansion resolved transitively via npm's bundled
          minimatch (npm@11.19.1 > minimatch@10.2.5 > brace-expansion@5.0.9).
          Build/CLI tooling only — not present in the application runtime
          path (app scan clean). Fixed in 5.0.11, but the version bundled
          by npm isn't independently controllable without patching npm's
          tree. Note: SNYK-JS-BRACEEXPANSION-18313044/18512280, previously
          ignored here, are confirmed resolved now that npm's bundled
          brace-expansion moved from 5.0.7 to 5.0.9 — removed from this
          file rather than left as dead entries. Recheck when npm bumps
          its bundled brace-expansion again.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-BRACEEXPANSION-20244952:
    - '*':
        reason: >
          Same root cause and dependency path as
          SNYK-JS-BRACEEXPANSION-20244948 — build/CLI tooling only, no
          direct upgrade available while bundled by npm (fixed in 5.0.10).
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-PICOMATCH-21248802:
    - '*':
        reason: >
          picomatch resolved transitively via npm's own bundled node-gyp
          (npm@11.19.1 > node-gyp@12.4.0 > tinyglobby@0.2.17 >
          picomatch@4.0.4). Build-time tool only (node-gyp compiles native
          modules during install), not present in the application's own
          dependency tree (app scan clean). Snyk reports no upgrade or
          patch available at all yet. Recheck when npm bumps its bundled
          node-gyp/tinyglobby.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-POSTCSSSELECTORPARSER-20510276:
    - '*':
        reason: >
          postcss-selector-parser resolved transitively via npm's own
          dependency-resolution tooling (npm@11.19.1 > @npmcli/arborist >
          @npmcli/query > postcss-selector-parser). Build/CLI tooling only,
          surfaced by the container scan against the "lib" project
          (/usr/local/lib/node_modules, npm's own global install) — not
          the application's own dependency tree (app scan clean). Fixed in
          postcss-selector-parser@7.1.6, but the version bundled by npm
          isn't independently controllable without patching npm itself.
          Recheck when npm bumps its bundled dependency.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-UNDICI-19635210:
    - '*':
        reason: >
          Vulnerable undici version pinned by npm's bundled node-gyp
          dependency (node-gyp@12.4.0 declares undici@6.28.0). Build-time
          tool only (node-gyp compiles native modules during install), not
          present in the running application's request path (this app's
          own undici, via cheerio, is separately pinned to 7.30.1 via the
          project's own overrides and is not affected). No fix available
          until node-gyp bumps its undici dependency.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-UNDICI-19635226:
    - '*':
        reason: >
          Same root cause as SNYK-JS-UNDICI-19635210 — vulnerable undici
          pinned via npm's bundled node-gyp dependency, build-time only,
          no fix currently available upstream.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-UNDICI-21181005:
    - '*':
        reason: >
          Same root cause as SNYK-JS-UNDICI-19635210 — npm's own bundled
          node-gyp/undici@6.28.0, build-time only, never exercised by this
          application's own code.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-UNDICI-21181013:
    - '*':
        reason: >
